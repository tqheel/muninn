# Copy to .env for local development tooling. Never commit .env.
# The browser app keeps its token in on-device storage instead.
RECOGNITION_PROVIDER=audd
RECOGNITION_API_TOKEN=
# For ACRCloud instead:
# RECOGNITION_PROVIDER=acrcloud
# ACRCLOUD_HOST=identify-us-west-2.acrcloud.com
# ACRCLOUD_ACCESS_KEY=
# ACRCLOUD_ACCESS_SECRET=
